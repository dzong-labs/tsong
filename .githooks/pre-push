#!/bin/sh
# The slow CI checks, before each push: coverage, the dependency audit, and
# the dependency graph check. Needs cargo-llvm-cov, cargo-audit and
# cargo-deny installed. Mutation testing runs on Linux only: in CI, or
# locally through scripts/linux.sh.
set -e
cargo llvm-cov --workspace --locked --fail-under-lines 95 --summary-only
cargo audit --deny warnings
# The fuzz crate keeps its own lockfile.
cargo audit --deny warnings --file fuzz/Cargo.lock
cargo deny --locked check bans licenses sources
